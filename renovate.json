{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>ralton-dev/.github"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard — personal_website",
  "packageRules": [
    {
      "description": "Group related Payload and Next.js minor/patch releases together.",
      "matchPackageNames": [
        "payload",
        "@payloadcms/**",
        "next",
        "@next/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Payload and Next.js"
    },
    {
      "description": "Group related OpenTelemetry minor/patch releases together.",
      "matchPackageNames": [
        "@opentelemetry/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "OpenTelemetry"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    }
  ]
}
